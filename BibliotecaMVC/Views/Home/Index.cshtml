@* ============================
   CAROUSEL DE NOVEDADES
   ============================ *@
<div class="container mt-5">
    <h2 class="mb-4 text-center">Novedades</h2>

    <div id="carouselLibros" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">

            <div class="carousel-item active">
                <img src="https://picsum.photos/900/300" class="d-block w-100 rounded" alt="Libro 1">
            </div>

            <div class="carousel-item">
                <img src="https://picsum.photos/900/301" class="d-block w-100 rounded" alt="Libro 2">
            </div>

            <div class="carousel-item">
                <img src="https://picsum.photos/900/302" class="d-block w-100 rounded" alt="Libro 3">
            </div>

        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#carouselLibros" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>

        <button class="carousel-control-next" type="button" data-bs-target="#carouselLibros" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</div>

@* ============================
   SECCIÓN INFORMATIVA DE BIBLIOTECA
   ============================ *@
<div class="container mt-5">
    <div class="row align-items-center">
        <div class="col-md-6">
            <h3 class="text-primary">Nuestra Biblioteca Virtual</h3>
            <p>
                BibliotecaMVC ofrece acceso a una colección digital de libros organizados por categorías
                literarias, autores destacados y áreas de estudio. Nuestro objetivo es facilitar la consulta
                de recursos bibliográficos y promover el aprendizaje continuo mediante una plataforma moderna
                y accesible.
            </p>
        </div>
        <div class="col-md-6 text-center">
            <img src="https://picsum.photos/600/350" class="img-fluid rounded shadow" alt="Colección de libros">
        </div>
    </div>
</div>

@* ============================
   CTA FINAL
   ============================ *@
<div class="container mt-5">
    <div class="bg-primary text-white rounded p-5 text-center">
        <h2>Explora nuestra Biblioteca Virtual</h2>
        <p>
            Miles de recursos disponibles para tu aprendizaje y crecimiento académico.
        </p>
        <a asp-controller="Home" asp-action="About" class="btn btn-outline-light btn-lg">
            Acerca de la Biblioteca
        </a>
    </div>
</div>
