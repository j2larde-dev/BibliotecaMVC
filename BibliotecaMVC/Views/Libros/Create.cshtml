@model BibliotecaMVC.Models.Libro

<section class="container mt-4">
    <h2 class="text-primary mb-4">Registrar Nuevo Libro</h2>

    <form asp-action="Create" method="post" class="row g-3">

        <div class="col-md-6">
            <label asp-for="Titulo" class="form-label fw-bold">Título</label>
            <input asp-for="Titulo" class="form-control" />
            <span asp-validation-for="Titulo" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Autor" class="form-label fw-bold">Autor</label>
            <input asp-for="Autor" class="form-control" />
            <span asp-validation-for="Autor" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Categoria" class="form-label fw-bold">Categoría</label>
            <input asp-for="Categoria" class="form-control" />
        </div>

        <div class="col-md-6">
            <label asp-for="Precio" class="form-label fw-bold">Precio</label>
            <input asp-for="Precio" class="form-control" />
            <span asp-validation-for="Precio" class="text-danger"></span>
        </div>

        <div class="col-md-6 d-flex align-items-center">
            <label asp-for="Disponible" class="form-label fw-bold me-3">Disponible</label>
            <input asp-for="Disponible" type="checkbox" class="form-check-input" />
        </div>

        <div class="col-12 mt-3">
            <button type="submit" class="btn btn-success">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>

    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
