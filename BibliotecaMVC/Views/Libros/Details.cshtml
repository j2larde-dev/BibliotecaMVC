@model BibliotecaMVC.Models.Libro

@{
    ViewData["Title"] = "Detalles del Libro";
}

<div class="card shadow-sm">
    <div class="card-body">

        <!-- Título del libro -->
        <h2 class="card-title">@Model.Titulo</h2>

        <!-- Autor del libro -->
        <h6 class="card-subtitle mb-3 text-muted">@Model.Autor</h6>

        <!-- Información del libro -->
        <dl class="row">

            <dt class="col-sm-4">Categoría</dt>
            <dd class="col-sm-8">@Model.Categoria</dd>

            <dt class="col-sm-4">Precio</dt>
            <dd class="col-sm-8">$@Model.Precio</dd>

            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">@(Model.Disponible ? "Disponible" : "Prestado")</dd>

        </dl>

        <!-- Botones de acción -->
        <div class="d-flex gap-2">

            <a class="btn btn-outline-secondary swal-edit-link"
               asp-action="Edit"
               asp-route-id="@Model.ID">
                Editar
            </a>

            <form asp-action="Delete"
                  asp-route-id="@Model.ID"
                  method="post"
                  class="swal-delete-form d-inline">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">
                    Eliminar
                </button>
            </form>

            <a asp-action="Index" class="btn btn-primary ms-auto">
                Volver al listado
            </a>

        </div>

    </div>
</div>
