
@model BibliotecaMVC.Models.Libro

<section class="container mt-4">
    <h2 class="text-primary mb-4">Detalle del Libro</h2>

    <div class="card shadow-sm p-4">
        <p><strong>ID:</strong> @Model.ID</p>
        <p><strong>Título:</strong> @Model.Titulo</p>
        <p><strong>Autor:</strong> @Model.Autor</p>
        <p><strong>Categoría:</strong> @Model.Categoria</p>
        <p><strong>Precio:</strong> $@Model.Precio</p>
        <p><strong>Disponible:</strong>
            <span class="badge @(Model.Disponible ? "bg-success" : "bg-danger")">
                @(Model.Disponible ? "Disponible" : "Prestado")
            </span>
        </p>
    </div>

    <a asp-action="Index" class="btn btn-secondary mt-3">Regresar</a>
</section>
