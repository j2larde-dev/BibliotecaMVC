@model IEnumerable<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Listado de Libros";
}

<h1>@ViewData["Title"]</h1>
<p>Hay @Model.Count() libros registrados.</p>

<a class="btn btn-primary" asp-action="Create">Nuevo Libro +</a>

<div class="row">
    @foreach (var libro in Model)
    {
        <div class="col-md-6">
             <div class="card card-libro mb-3">
                <div class="card-body">

                    <img src="~/images/@libro.Imagen" class="img-libro mb-3" alt="@libro.Titulo" />

                    <h5>@libro.Titulo</h5>
                    <h6>@libro.Autor</h6>

                    <p><strong>Categoría:</strong> @libro.Categoria</p>
                    <p><strong>Precio:</strong> $@libro.Precio</p>
                    <p><strong>Disponible:</strong> @(libro.Disponible ? "Sí" : "No")</p>

                    <a asp-action="Details" asp-route-id="@libro.ID">Ver</a>
                    <a asp-action="Edit" asp-route-id="@libro.ID" class="btn btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@libro.ID" class="btn btn-danger">Eliminar</a>

                </div>
            </div>
        </div>
    }
</div>
