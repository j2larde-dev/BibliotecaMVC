@model IEnumerable<BibliotecaMVC.Models.Libro>
@if (Context.Request.Query.ContainsKey("success"))
{
    <div id="success-message" data-message="@Context.Request.Query["success"]"></div>
}

@{
    ViewData["Title"] = "Libros";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">
        @ViewData["Title"]
        <small class="text-muted">(@Model.Count())</small>
    </h1>

    <a class="btn btn-primary" asp-action="Create">Nuevo Libro +</a>
</div>

<!-- ============================
     TABLA PRINCIPAL (Escritorio)
=============================== -->
<div class="d-none d-md-block">
    <table class="table table-hover table-bordered shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Título</th>
                <th>Autor</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Disponible</th>
                <th style="width: 220px;">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var libro in Model)
            {
                <tr>
                    <td>@libro.ID</td>
                    <td>@libro.Titulo</td>
                    <td>@libro.Autor</td>
                    <td>@libro.Categoria</td>
                    <td>$@libro.Precio</td>
                    <td>@(libro.Disponible ? "Disponible" : "Prestado")</td>

                    <td class="d-flex gap-2">
                        <a class="btn btn-outline-primary btn-sm"
                           asp-action="Details"
                           asp-route-id="@libro.ID">
                            Detalles
                        </a>

                        <a class="btn btn-outline-secondary btn-sm swal-edit-link"
                           asp-action="Edit"
                           asp-route-id="@libro.ID">
                            Editar
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@libro.ID"
                              method="post"
                              class="swal-delete-form d-inline">

                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-danger btn-sm">
                                Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- ============================
     TARJETAS (Móviles)
=============================== -->
<div class="d-md-none">
    @foreach (var libro in Model)
    {
        <div class="card p-3 mb-3 shadow-sm">
            <p><strong>ID:</strong> @libro.ID</p>
            <p><strong>Título:</strong> @libro.Titulo</p>
            <p><strong>Autor:</strong> @libro.Autor</p>
            <p><strong>Categoría:</strong> @libro.Categoria</p>
            <p><strong>Precio:</strong> $@libro.Precio</p>

            <p><strong>Disponible:</strong> @(libro.Disponible ? "Disponible" : "Prestado")</p>

            <div class="d-flex gap-2 mt-2">
                <a class="btn btn-outline-primary btn-sm"
                   asp-action="Details"
                   asp-route-id="@libro.ID">
                    Detalles
                </a>

                <a class="btn btn-outline-secondary btn-sm swal-edit-link"
                   asp-action="Edit"
                   asp-route-id="@libro.ID">
                    Editar
                </a>

                <form asp-action="Delete"
                      asp-route-id="@libro.ID"
                      method="post"
                      class="swal-delete-form d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-danger btn-sm">
                        Eliminar
                    </button>
                </form>
            </div>
        </div>
    }
</div>
