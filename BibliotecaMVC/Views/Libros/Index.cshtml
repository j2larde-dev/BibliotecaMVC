@model IEnumerable<BibliotecaMVC.Models.Libro>

<header class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary">Listado de Libros</h2>

    <a class="btn btn-success" asp-controller="Libros" asp-action="Create">
        Agregar Libro +
    </a>
</header>

<!-- ============================
     TABLA NORMAL (solo escritorio)
=============================== -->
<div class="d-none d-md-block">
    <table class="table table-hover table-bordered shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Título</th>
                <th>Autor</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Disponible</th>
                <th style="width: 180px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var libro in Model)
            {
                <tr>
                    <td>@libro.ID</td>
                    <td>@libro.Titulo</td>
                    <td>@libro.Autor</td>
                    <td>@libro.Categoria</td>
                    <td>$@libro.Precio</td>
                    <td>
                        <span class="badge @(libro.Disponible ? "bg-success" : "bg-danger")">
                            @(libro.Disponible ? "Disponible" : "Prestado")
                        </span>
                    </td>
                    <td class="d-flex gap-2">
                        <a class="btn btn-info btn-sm"
                           asp-controller="Libros"
                           asp-action="Details"
                           asp-route-id="@libro.ID">Ver</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- ============================
     TARJETAS (solo móviles)
=============================== -->
<div class="d-md-none table-responsive-card">
    @foreach (var libro in Model)
    {
        <div class="card p-3 mb-3 shadow-sm">
            <p><strong>ID:</strong> @libro.ID</p>
            <p><strong>Título:</strong> @libro.Titulo</p>
            <p><strong>Autor:</strong> @libro.Autor</p>
            <p><strong>Categoría:</strong> @libro.Categoria</p>
            <p><strong>Precio:</strong> $@libro.Precio</p>
            <p>
                <strong>Disponible:</strong>
                <span class="badge @(libro.Disponible ? "bg-success" : "bg-danger")">
                    @(libro.Disponible ? "Disponible" : "Prestado")
                </span>
            </p>

            <div class="d-flex gap-2 mt-2">
                <a class="btn btn-info btn-sm"
                   asp-controller="Libros"
                   asp-action="Details"
                   asp-route-id="@libro.ID">Ver</a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        var mensaje = '@(TempData["SuccessMessage"] ?? "")';

        if (mensaje) {
            Swal.fire({
                icon: 'success',
                title: 'Éxito',
                text: mensaje,
                timer: 2000,
                showConfirmButton: false
            });
        }
    </script>
}
