@model BibliotecaMVC.Models.Libro

@{
    ViewData["Title"] = "Eliminar Libro";
}

<h1>¿Desea eliminar este libro?</h1>

<dl class="row">
    <dt>Título</dt>
    <dd>@Model.Titulo</dd>

    <dt>Autor</dt>
    <dd>@Model.Autor</dd>

    <dt>Categoría</dt>
    <dd>@Model.Categoria</dd>

    <dt>Precio</dt>
    <dd>@Model.Precio</dd>

    <dt>Disponible</dt>
    <dd>@(Model.Disponible ? "Sí" : "No")</dd>
</dl>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="ID" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
