@model IEnumerable<BibliotecaMVC.Models.Autor>

<h2>Catálogo de Autores</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Nacionalidad</th>
            <th>Fecha de Nacimiento</th>
            <th>Edad</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var autor in Model)
        {
            <tr>
                <td>@autor.Id</td>
                <td>@autor.Nombre</td>
                <td>@autor.Nacionalidad</td>
                <td>@autor.FechaNacimiento.ToString("yyyy-MM-dd")</td>
                <td>@(DateTime.Now.Year - autor.FechaNacimiento.Year)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@autor.Id" class="btn btn-primary btn-sm">
                        Ver
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
